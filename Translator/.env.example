# Copy to .env and fill in your values, then:  source .env

# ── LLM backend (pick ONE) ────────────────────────────────────────────────
# Option A: Anthropic Claude (cloud, requires API key)
# export ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option B: Ollama (local, no API key needed)
#   Install: brew install ollama
#   Start:   ollama serve
#   Model:   ollama pull llama3.2
# export OLLAMA_URL=http://localhost:11434   # default
# export OLLAMA_MODEL=llama3.2              # default

# ── Speech-to-text ────────────────────────────────────────────────────────
export WHISPER_MODEL=$HOME/.whisper-models/ggml-base.bin
# export WHISPER_BIN=whisper-cpp           # default

# ── Lesson settings ───────────────────────────────────────────────────────
# export TARGET_LANGUAGE=Spanish           # default
# export DIFFICULTY=1                      # 1-5, default 1
# export RECORDING_SECONDS=8              # default
